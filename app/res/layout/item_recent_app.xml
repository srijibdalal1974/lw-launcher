<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_recent_root"
    android:layout_width="260dp"
    android:layout_height="450dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/recents_card_bg"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="14dp"
    android:clickable="true"
    android:focusable="true">

    <!-- CARD HEADER: APP ICON + APP NAME + CLOSE BTN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/iv_recent_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_recent_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Name"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_recent_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Running in background"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_recent_close_card"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close app" />
    </LinearLayout>

    <!-- CARD PREVIEW SURFACE (MOCK PHONE SCREEN/SNAPSHOT) -->
    <FrameLayout
        android:id="@+id/recent_preview_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/recents_card_preview_bg"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_recent_large_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="fitCenter"
                android:alpha="0.85" />

            <TextView
                android:id="@+id/tv_recent_pkg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="com.example.app"
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Swipe up to close"
                android:textColor="#99A0B0"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </FrameLayout>

    <!-- BOTTOM ACTIONS ON CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/btn_recent_open"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/recents_pill_btn_bg"
            android:gravity="center"
            android:text="Open"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_recent_info"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/recents_pill_btn_bg"
            android:gravity="center"
            android:text="Info"
            android:textColor="#C0CADC"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
