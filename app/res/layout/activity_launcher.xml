<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HOME SCREEN -->
    <RelativeLayout
        android:id="@+id/home_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="44dp"
        android:paddingBottom="24dp">

        <!-- AT A GLANCE (LEGACY HIDDEN HEADER - CALENDAR NOW RENDERS ON UNIFIED GRID) -->
        <LinearLayout
            android:id="@+id/at_a_glance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Friday, Nov 20"
                android:textSize="26sp"
                android:textColor="@color/at_a_glance_text"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#99000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/tv_glance_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap for Calendar"
                android:textSize="14sp"
                android:textColor="@color/text_secondary_white"
                android:fontFamily="sans-serif"
                android:layout_marginTop="3dp"
                android:shadowColor="#99000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- TOP SEARCH BAR CONTAINER (UP POSITION - HOLDS ORIGINAL GOOGLE WIDGET ONLY) -->
        <FrameLayout
            android:id="@+id/search_bar_top_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:minHeight="54dp"
            android:visibility="gone" />

        <!-- HORIZONTAL MULTI-PAGE CONTAINER (DYNAMIC PAGES) -->
        <com.custom.pixellauncher.SmoothHomePager
            android:id="@+id/hsv_home_pages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/search_bar_top_container"
            android:layout_above="@id/layout_page_dots"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/ll_home_pages"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </com.custom.pixellauncher.SmoothHomePager>

        <!-- DYNAMIC PAGE INDICATOR PILLS -->
        <LinearLayout
            android:id="@+id/layout_page_dots"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_above="@id/bottom_dock_container"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="2dp" />

        <!-- BOTTOM DOCK CONTAINER (Pixel order: Dock icons above Google Search pill) -->
        <LinearLayout
            android:id="@+id/bottom_dock_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <!-- PINNED DOCK APPS (CUSTOMIZABLE 60DP ICONS) -->
            <LinearLayout
                android:id="@+id/dock_icons"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="5">

                <FrameLayout
                    android:id="@+id/dock_slot_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/dock_iv_0"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:background="@drawable/item_app_ripple"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/dock_slot_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/dock_iv_1"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:background="@drawable/item_app_ripple"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/dock_slot_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/dock_iv_2"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:background="@drawable/item_app_ripple"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/dock_slot_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/dock_iv_3"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:background="@drawable/item_app_ripple"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/dock_slot_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/dock_iv_4"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:background="@drawable/item_app_ripple"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>
            </LinearLayout>

            <!-- SEARCH BAR CONTAINER (HOLDS ORIGINAL GOOGLE WIDGET OR PIXEL SEARCH PILL AT BOTTOM) -->
            <FrameLayout
                android:id="@+id/search_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp">

                <LinearLayout
                    android:id="@+id/pixel_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/search_bar_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:elevation="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/btn_google_g"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_google_g"
                        android:contentDescription="Google" />

                    <TextView
                        android:id="@+id/tv_search_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="@color/search_text_color"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="12dp" />

                    <ImageView
                        android:id="@+id/btn_ai_mode"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="7dp"
                        android:src="@drawable/ic_search"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Search" />

                    <ImageView
                        android:id="@+id/btn_voice_search"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_mic"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Voice Search"
                        android:layout_marginStart="2dp" />

                    <ImageView
                        android:id="@+id/btn_lens"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_lens"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Lens"
                        android:layout_marginStart="2dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- APP DRAWER OVERLAY (Pixel Material 3 Frosted Translucent Sheet) -->
    <LinearLayout
        android:id="@+id/app_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/drawer_bg"
        android:orientation="vertical"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:paddingTop="44dp">

        <!-- TOP DRAG HANDLE PILL -->
        <View
            android:id="@+id/drawer_drag_handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- PIXEL PILL SEARCH HEADER -->
        <LinearLayout
            android:id="@+id/drawer_search_bar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/drawer_search_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_drawer_search_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_google_g"
                android:background="@drawable/popup_item_bg"
                android:contentDescription="Google app"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tv_drawer_typeahead_hint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|start"
                    android:textColor="@color/text_on_surface_secondary"
                    android:textSize="15.5sp"
                    android:fontFamily="sans-serif"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/et_drawer_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Search web and more"
                    android:textColorHint="@color/text_on_surface_secondary"
                    android:textColor="@color/text_on_surface"
                    android:textSize="15.5sp"
                    android:fontFamily="sans-serif"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_drawer_mic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_mic"
                android:padding="6dp"
                android:background="@drawable/popup_item_bg"
                android:contentDescription="Voice search"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_drawer_lens"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_lens"
                android:padding="6dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/popup_item_bg"
                android:contentDescription="Google Lens"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_close_drawer"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_close"
                android:tint="@color/icon_on_surface"
                android:padding="7dp"
                android:visibility="gone"
                android:background="@drawable/popup_item_bg"
                android:contentDescription="Clear search"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- OPTIONAL ORIGINAL GOOGLE SEARCH WIDGET CAPSULE IN APP DRAWER -->
        <FrameLayout
            android:id="@+id/drawer_google_widget_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- APPS GRID + SCROLL-LINKED SUGGESTIONS HEADER + PIXEL SEARCH RESULTS + FAST SCROLLBAR -->
        <FrameLayout
            android:id="@+id/drawer_grid_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/gv_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="4"
                android:verticalSpacing="14dp"
                android:horizontalSpacing="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:stretchMode="columnWidth"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none"
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="18dp"
                android:cacheColorHint="@android:color/transparent"
                android:clipToPadding="false"
                android:overScrollMode="always"
                android:gravity="center" />

            <!-- SUGGESTED APPS + ALL APPS HEADER (SCROLLS IN LOCKSTEP WITH GV_APPS TOP PADDING) -->
            <LinearLayout
                android:id="@+id/ll_drawer_header_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/ll_drawer_predictions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:weightSum="4" />

                <TextView
                    android:id="@+id/tv_drawer_all_apps_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="All apps"
                    android:gravity="center"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_on_surface"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- PIXEL UNIFIED SEARCH RESULTS VIEW (APPS + WEB SEARCH SUGGESTIONS + PLAY STORE) -->
            <ScrollView
                android:id="@+id/sv_drawer_search_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:scrollbars="none"
                android:overScrollMode="always"
                android:clipToPadding="false"
                android:paddingBottom="280dp">

                <LinearLayout
                    android:id="@+id/ll_drawer_search_results_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </ScrollView>

            <com.custom.pixellauncher.DrawerFastScrollbarView
                android:id="@+id/drawer_scrollbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- FLOATING DRAG OVERLAY (Lawnchair DragLayer) -->
    <FrameLayout
        android:id="@+id/drag_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="60dp">

        <!-- BACKGROUND BLUR / FROSTED SCRIM (Disabled for Pixel Launcher clarity) -->
        <View
            android:id="@+id/drag_blur_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone" />

        <!-- TOP DROP TARGETS BAR (Android 17 / Pixel Launcher) -->
        <LinearLayout
            android:id="@+id/ll_drop_targets_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="36dp"
            android:paddingBottom="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <!-- REMOVE TARGET (Can / Remove from Home) -->
            <LinearLayout
                android:id="@+id/drop_target_remove"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/drop_target_bg"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/iv_drop_remove_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_remove" />

                <TextView
                    android:id="@+id/tv_drop_remove_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Remove"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- UNINSTALL TARGET (Android 17 Uninstall) -->
            <LinearLayout
                android:id="@+id/drop_target_uninstall"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/drop_target_bg"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/iv_drop_uninstall_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_uninstall" />

                <TextView
                    android:id="@+id/tv_drop_uninstall_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Uninstall"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- FLOATING PAGE CHIPS OVER THE BLUR (1 2 3 4 5....) -->
        <HorizontalScrollView
            android:id="@+id/hsv_drag_page_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="145dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:visibility="gone"
            android:elevation="35dp">

            <LinearLayout
                android:id="@+id/ll_drag_page_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/page_chips_bar_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <ImageView
            android:id="@+id/iv_floating_drag"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="fitCenter"
            android:elevation="40dp" />
    </FrameLayout>

    <!-- ANDROID 17 CUSTOMIZATION PANEL OVERLAY -->
    <FrameLayout
        android:id="@+id/customization_panel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:visibility="gone"
        android:elevation="70dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/panel_customization_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="160dp"
            android:background="@drawable/panel_customization_bg"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:elevation="12dp"
            android:clickable="true"
            android:focusable="true">

            <!-- WALLPAPER CAROUSEL -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp">

                    <!-- Current Wallpaper Card (Pixel rounded square preview) -->
                    <FrameLayout
                        android:id="@+id/card_wallpaper_current"
                        android:layout_width="100dp"
                        android:layout_height="108dp"
                        android:background="@drawable/wallpaper_card_selected"
                        android:padding="3dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/iv_wallpaper_thumb_current"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check_circle" />
                    </FrameLayout>

                    <!-- Theme Card 2 -->
                    <FrameLayout
                        android:id="@+id/card_wallpaper_theme1"
                        android:layout_width="58dp"
                        android:layout_height="108dp"
                        android:background="@drawable/wallpaper_card_2_bg"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Theme Card 3 -->
                    <FrameLayout
                        android:id="@+id/card_wallpaper_theme2"
                        android:layout_width="58dp"
                        android:layout_height="108dp"
                        android:background="@drawable/wallpaper_card_3_bg"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Theme Card 4 -->
                    <FrameLayout
                        android:id="@+id/card_wallpaper_theme3"
                        android:layout_width="58dp"
                        android:layout_height="108dp"
                        android:background="@drawable/wallpaper_card_4_bg"
                        android:layout_marginEnd="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- ACTION 1: Wallpaper and style -->
            <LinearLayout
                android:id="@+id/row_action_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/popup_item_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_wallpaper"
                    android:tint="@color/icon_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Wallpaper and style"
                    android:textColor="@color/text_on_surface"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- ACTION 2: Widgets -->
            <LinearLayout
                android:id="@+id/row_action_widgets"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/popup_item_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_widgets"
                    android:tint="@color/icon_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Widgets"
                    android:textColor="@color/text_on_surface"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- ACTION 3: Apps list -->
            <LinearLayout
                android:id="@+id/row_action_apps"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/popup_item_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_apps_list"
                    android:tint="@color/icon_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Apps list"
                    android:textColor="@color/text_on_surface"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- ACTION 4: Home settings -->
            <LinearLayout
                android:id="@+id/row_action_settings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/popup_item_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/icon_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Home settings"
                    android:textColor="@color/text_on_surface"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <com.custom.pixellauncher.LaunchTransitionView
        android:id="@+id/launch_transition_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
