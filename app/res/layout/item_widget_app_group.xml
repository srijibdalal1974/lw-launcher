<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp">

    <!-- APP HEADER (EXPANDABLE ROW) -->
    <LinearLayout
        android:id="@+id/row_app_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/card_rounded_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_app_group_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_app_group_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="App Name"
            android:textColor="@color/text_on_surface"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_app_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_inactive_bg"
            android:text="3 widgets"
            android:textColor="@color/text_on_surface_secondary"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginEnd="10dp" />

        <ImageView
            android:id="@+id/iv_app_group_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_down"
            android:tint="@color/icon_on_surface_muted" />
    </LinearLayout>

    <!-- EXPANDABLE CONTAINER FOR WIDGETS OF THIS APP -->
    <LinearLayout
        android:id="@+id/ll_app_widgets_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

</LinearLayout>
