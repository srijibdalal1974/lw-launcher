<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_rounded_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/iv_widget_entry_preview"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widgets" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tv_widget_entry_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Widget Label"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_widget_entry_dimensions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 × 2"
            android:textColor="#8EA0B2"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_widget_entry_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_active_bg"
        android:text="Add"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
