<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_rounded_bg"
    android:padding="20dp">

    <!-- TOP DRAG HANDLE -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/pill_inactive_bg"
        android:layout_marginBottom="14dp" />

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/icon_on_surface"
                android:background="@drawable/card_rounded_bg"
                android:padding="7dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home Settings"
                    android:textColor="@color/text_on_surface"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pixel Expressive • Android 16/17"
                    android:textColor="@color/text_on_surface_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_close_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/pill_inactive_bg"
            android:text="✕"
            android:textColor="@color/text_on_surface"
            android:gravity="center"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- DEFAULT LAUNCHER CARD -->
            <LinearLayout
                android:id="@+id/card_default_launcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_rounded_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_apps_list"
                    android:tint="@color/icon_on_surface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default Home App"
                        android:textColor="@color/text_on_surface"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_default_home_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active as Default Launcher"
                        android:textColor="@color/text_on_surface_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_action_default_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_active_bg"
                    android:text="Active"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- ELEMENTS CARD (SEARCH BAR & AT A GLANCE TOGGLES) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_rounded_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <!-- SEARCH BAR ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_google_g" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Google Search Bar"
                            android:textColor="@color/text_on_surface"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Draggable to Remove or any page"
                            android:textColor="@color/text_on_surface_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/sw_toggle_search_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_line"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp" />

                <!-- AT A GLANCE ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_lens" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="At a Glance"
                            android:textColor="@color/text_on_surface"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live date (Calendar) &amp; weather (Pixel Weather)"
                            android:textColor="@color/text_on_surface_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/sw_toggle_at_a_glance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- DIVIDER (HIDDEN WITH DRAWER GOOGLE WIDGET TOGGLE) -->
                <View
                    android:id="@+id/divider_drawer_google_widget"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_line"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <!-- DRAWER GOOGLE WIDGET ROW (HIDDEN) -->
                <LinearLayout
                    android:id="@+id/row_drawer_google_widget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/icon_on_surface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Original Google Capsule (Drawer)"
                            android:textColor="@color/text_on_surface"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Use live Google Search widget instead of inline app filter"
                            android:textColor="@color/text_on_surface_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/sw_toggle_drawer_google_widget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- GRID DENSITY CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_rounded_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home Grid Density"
                    android:textColor="@color/text_on_surface"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/btn_grid_mode_4x5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="4 × 5"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/pill_active_bg"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/btn_grid_mode_5x5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="5 × 5"
                        android:textColor="@color/text_on_surface"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/pill_inactive_bg"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" />

                    <TextView
                        android:id="@+id/btn_grid_mode_16x9"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="16 × 9"
                        android:textColor="@color/text_on_surface"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/pill_inactive_bg"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- DISPLAY REFRESH RATE ADAPTATION CARD (HIDDEN - AUTO ADAPTS TO DISPLAY MAXIMUM) -->
            <LinearLayout
                android:id="@+id/card_refresh_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_rounded_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Animation Frame Rate"
                    android:textColor="@color/text_on_surface"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_refresh_rate_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto (up to 180 Hz)"
                    android:textColor="@color/text_on_surface_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/ll_hz_pills_row"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- SYSTEM SETTINGS ROW -->
            <LinearLayout
                android:id="@+id/card_system_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_rounded_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/icon_on_surface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Android System Settings"
                        android:textColor="@color/text_on_surface"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display, Wallpaper, Sounds &amp; Apps"
                        android:textColor="@color/text_on_surface_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    android:tint="@color/icon_on_surface_muted"
                    android:rotation="270" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
