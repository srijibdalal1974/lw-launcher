<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) requirement: data extraction rules.
    Explicitly disabling cloud backup and device-to-device transfer
    for a launcher (no sensitive data to back up).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
